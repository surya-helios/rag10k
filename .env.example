# Copy this file to ".env" (same folder) and fill in the two keys. Never share or commit .env.
PINECONE_API_KEY=
GOOGLE_API_KEY=

# Optional: use Nebius Token Factory instead of Gemini for generation and judging
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# (then set GEN_MODEL and JUDGE_MODEL from `python list_models.py`)

# Optional overrides (defaults are in config.py)
# PINECONE_INDEX=tenk-rag
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# GEN_MODEL=gemini-3.5-flash
# JUDGE_MODEL=gemini-3.5-flash-lite
